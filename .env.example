# Neon (Vercel Marketplace). Pooled URL for the app, unpooled for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk (development instance: pk_test_ / sk_test_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Vercel Cron: the nightly demo reset (/api/cron/reset-demo) checks this bearer token
CRON_SECRET=

# SIGNoFF admin (comma-separated Clerk user IDs)
ADMIN_USER_IDS=

# Demo workspace and people (Step 1)
DEMO_ORG_ID=
DEMO_OWNER_USER_ID=
DEMO_LEO_USER_ID=
DEMO_AMA_USER_ID=
DEMO_JEN_USER_ID=
DEMO_CLIENT_USER_ID=
DEMO_ADMIN_USER_ID=

# Optional: the day the demo data is built around (YYYY-MM-DD). Unset = the day the seed runs.
# 2026-11-24 reproduces the design images exactly.
DEMO_ANCHOR_DATE=
